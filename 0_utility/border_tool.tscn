[gd_scene format=3 uid="uid://6gfwycv1j2my"]

[sub_resource type="GDScript" id="GDScript_dlfbb"]
script/source = "@tool
extends StaticBody2D

@export var width: int = 1152
@export var height: int = 648

@export var use_settings: bool = true

@export_tool_button(\"Apply\") var apply_action = _move_border


func _move_border():
	if use_settings:
		width = ProjectSettings.get_setting(\"display/window/size/viewport_width\")
		height = ProjectSettings.get_setting(\"display/window/size/viewport_height\")
		self.notify_property_list_changed()
	$right.position.x = width
	$right.notify_property_list_changed()
	$bottom.position.y = height
	$bottom.notify_property_list_changed()

func _ready() -> void:
	if use_settings:
		width = ProjectSettings.get_setting(\"display/window/size/viewport_width\")
		height = ProjectSettings.get_setting(\"display/window/size/viewport_height\")
	$right.position.x = width
	$bottom.position.y = height
"

