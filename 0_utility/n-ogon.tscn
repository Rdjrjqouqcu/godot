[gd_scene format=3 uid="uid://ct421if7r37gk"]

[sub_resource type="GDScript" id="GDScript_c24ra"]
script/source = "@tool
extends Polygon2D

@export var radius: float = 64
@export_range(3, 20, 1, \"or_greater\") var point_count: int = 6
@export var initial_angle: Vector2 = Vector2.UP

@export var hollow: bool = true
@export var thickness: int = 2

@export_tool_button(\"Apply\") var action = _apply

func _apply() -> void:
	var first: Vector2 = initial_angle.normalized() * radius
	var points: Array[Vector2] = [first]

	for i in range(1, point_count):
		points.append(first.rotated(deg_to_rad(360.0 / point_count) * i))

	if hollow:
		points.append(first)
		for i in range(point_count + 1):
			points.append(points[point_count - i].normalized() * (radius - thickness))

	self.polygon = PackedVector2Array(points)
	self.notify_property_list_changed()

func _ready() -> void:
	_apply()
"

