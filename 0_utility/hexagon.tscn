[gd_scene format=3 uid="uid://dsxi8ol43kexm"]

[sub_resource type="GDScript" id="GDScript_533f2"]
script/source = "@tool
extends Polygon2D

@export var edge: int = 64

@export_tool_button(\"Apply\") var action = _apply

func _apply() -> void:
	var length: float = edge / (1 + sqrt(2))
	var left: int = int((edge - length) / 2)
	var right: int = edge - left
	self.polygon = PackedVector2Array([
		Vector2(left,0),
		Vector2(right,0),
		Vector2(edge,left),
		Vector2(edge,right),
		Vector2(right,edge),
		Vector2(left,edge),
		Vector2(0,right),
		Vector2(0,left),
	])
	self.notify_property_list_changed()

func _ready() -> void:
	_apply()
"

[node name="hexagon" type="Polygon2D" unique_id=1823396301]
